{
  "ConnectionStrings": {
    "ApplicationDatabase": "",
    "PlatformDatabase": ""
  },
  "Jwt": {
    "Issuer": "saviaup-api",
    "Audience": "saviaup-web",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "PasswordPolicy": {
    "MinimumLength": 10,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true
  },
  "Frontend": {
    "BaseUrl": "https://app.saviaup.com"
  },
  "AdminApi": {
    "BaseUrl": "http://localhost:5100",
    "TimeoutSeconds": 5
  },
  "Email": {
    "Mode": "Smtp",
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@saviaup.com",
    "FromName": "Savia Up"
  },
  "Cors": {
    "AllowedOrigins": [ "https://app.saviaup.com" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
